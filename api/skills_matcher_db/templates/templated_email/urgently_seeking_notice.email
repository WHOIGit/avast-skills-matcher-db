
{% block subject %}WHOI Skills Matcher DB - New User Urgently Seeking Project{% endblock %}
{% block plain %}
  Hello,

  The following user has updated their Skills Matcher profile to "Urgently Seeking Project":
  {{user_name}} ( {{user_email}} )

  You can view their profile here: https://skillsdb.whoi.edu/experts/{{user_id}}

  Thanks from the WHOI Skills Matcher DB!
{% endblock %}

{% block html %}
  <p>Hello,</p>

  <p>The following user has updated their Skills Matcher profile to "Urgently Seeking Project":
      <ul>
        <li>{{user_name}} ( {{user_email}} )</li>
      </ul>
  </p>

  <p>You can view their profile here: <a href="https://skillsdb.whoi.edu/experts/{{user_id}}">User profile</a>
  
  <p>Thanks from the WHOI Skills Matcher DB!</p>
{% endblock %}